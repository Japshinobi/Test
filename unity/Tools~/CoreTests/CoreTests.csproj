<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the game rules outside Unity: dotnet run (folders ending in ~ are ignored by Unity) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Ogorod/Core/**/*.cs" />
  </ItemGroup>
</Project>
